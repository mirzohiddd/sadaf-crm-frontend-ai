# Vite dev-server (npm run dev) /api va /ws so'rovlarini shu backendga uzatadi.
# Lokal backend uchun:
VITE_BACKEND_URL=https://sadaf-crm-ai.onrender.com# Masofaviy backend bilan ishlash uchun, masalan:
# VITE_BACKEND_URL=https://sadaf-backend-api.onrender.com

# Production build (Vercel va h.k.): backend boshqa domenda bo'lsa to'liq URL bering
# (masalan https://sadaf-backend-api.onrender.com yoki .../api — ikkalasi ham ishlaydi).
# Bo'sh qoldirilsa /api ishlatiladi va proxy orqali ketadi.
# VITE_API_URL=

# MUHIM: frontend .env ga hech qachon GROQ_API_KEY yoki boshqa maxfiy kalit
# yozmang — VITE_ bilan boshlanuvchi har qanday qiymat brauzerga ochiq chiqadi.
# AI kaliti faqat backend/.env da turadi.

# WebSocket manzili (ixtiyoriy). Bo'sh bo'lsa VITE_API_URL dan avtomatik
# hosil qilinadi (https://x.onrender.com/api -> wss://x.onrender.com/ws).
# VITE_WS_URL=
